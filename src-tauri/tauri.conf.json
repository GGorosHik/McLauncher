{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MC Launcher",
  "mainBinaryName": "mc-launcher",
  "version": "0.1.0",
  "identifier": "com.mclauncher.app",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MC Launcher",
        "width": 760,
        "height": 620,
        "minWidth": 640,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
